{
  "rewrites": [
    { "source": "/api/clients/:id", "destination": "/api/customer-requests?managementRoute=client-item&id=:id" },
    { "source": "/api/clients", "destination": "/api/customer-requests?managementRoute=clients" },
    { "source": "/api/projects/assignees", "destination": "/api/customer-requests?managementRoute=staff" },
    { "source": "/api/projects/:id", "destination": "/api/customer-requests?managementRoute=project-item&id=:id" },
    { "source": "/api/projects", "destination": "/api/customer-requests?managementRoute=projects" },
    { "source": "/api/tasks/:id/documents/:documentId", "destination": "/api/tasks?taskRoute=attachments&id=:id&documentId=:documentId" },
    { "source": "/api/tasks/:id/documents", "destination": "/api/tasks?taskRoute=attachments&id=:id" },
    { "source": "/api/tasks/:id", "destination": "/api/tasks?taskRoute=item&id=:id" },
    { "source": "/api/documents/:id/content", "destination": "/api/documents?documentRoute=content&id=:id" },
    { "source": "/api/documents/:id/download", "destination": "/api/documents?documentRoute=download&id=:id" },
    { "source": "/api/documents/:id", "destination": "/api/documents?documentRoute=item&id=:id" },
    { "source": "/api/admin/customer-requests", "destination": "/api/customer-requests?requestRoute=admin-list" },
    { "source": "/api/admin/customer-requests/:id", "destination": "/api/customer-requests?requestRoute=admin-item&id=:id" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/register/", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/login/", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/account/", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/projects/", "destination": "/index.html" }
  ]
}
