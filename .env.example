# PostgreSQL connection string used only by the server-side API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Set to "false" only for a local PostgreSQL server that does not support TLS.
DATABASE_SSL=true

# Single administrator credentials. Generate the hash and secret with the provided script.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$BASE64URL_SALT$BASE64URL_HASH
SESSION_SECRET=replace-with-at-least-32-random-characters

# Member authentication reuses DATABASE_URL. It requires no additional secret.
